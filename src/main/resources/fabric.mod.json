{
	"schemaVersion": 1,
	"id": "crackers",
	"version": "${version}",
	"name": "Crackers",
	"description": "Easy-to-use client-sided Fabric 26.2 Seed Cracker. Start with /cracker.",
	"authors": [
		"TCMFatbird"
	],
	"contact": {
		"sources": "https://github.com/TCMFatbird/crackers"
	},
	"license": "MIT",
	"icon": "assets/crackers/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.birb.crackers.SeedCracker"
		]
	},
	"mixins": [
		"crackers.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=26.2 <26.3",
		"java": ">=25",
		"fabric-api-base": "*",
		"fabric-command-api-v2": "*",
		"fabric-lifecycle-events-v1": "*",
		"fabric-resource-loader-v0": "*"
	}
}
